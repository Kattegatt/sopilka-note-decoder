{
  "name": "sopilka-note-decoder",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsx watch server/main.ts\"",
    "build": "vite build && node scripts/build-offline.mjs && tsc -p tsconfig.server.json",
    "start": "node build/server/main.js",
    "faust:build": "mkdir -p public/faust/waveguide && node node_modules/@grame/faustwasm/scripts/faust2wasm.js dsp/faust-waveguide-flute.dsp public/faust/waveguide -no-template",
    "test": "npm run unit && npm run build && node --test tests/rendered-html.test.mjs",
    "unit": "vitest run --config vitest.config.ts",
    "lint": "eslint . --ignore-pattern dist",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test:e2e": "playwright test",
    "test:runtime": "node scripts/check-runtime.mjs"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@grame/faustwasm": "^0.16.6",
    "@tonejs/midi": "^2.0.28",
    "better-auth": "^1.7.7",
    "better-sqlite3": "^13.0.3",
    "dompurify": "^3.4.14",
    "fastify": "^5.12.5",
    "idb": "^8.0.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "verovio": "^6.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "concurrently": "^10.0.5",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
