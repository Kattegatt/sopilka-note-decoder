# Copy to /srv/apps/sopilka/.env for production. Never put these values in VITE_*.
BETTER_AUTH_URL=https://sopilka.kattegatt.org
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Сопілка <noreply@example.com>
# DATABASE_PATH is supplied by the production container.
# Local development runs without SMTP and prints links to the API terminal.
